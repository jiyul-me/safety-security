root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,slnx,manifest}]
indent_size = 2

[*.ps1]
end_of_line = crlf
charset = utf-8-bom

# Inno Setup 스크립트: 한글 문구가 있어서 BOM이 필요해요 (ISCC가 UTF-8로 읽어요).
[*.iss]
end_of_line = crlf
charset = utf-8-bom
